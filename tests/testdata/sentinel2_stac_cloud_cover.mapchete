process: read_xarray.py
input:
  inp:
    format: Sentinel-2
    time:
      start: 2023-08-10
      end: 2023-08-13
    source:
      query: "eo:cloud_cover<=20"
      collection: sentinel2/full_products/sentinel-2-l2a/collection.json
output:
  format: GTiff
  bands: 3
  path: stac
  dtype: uint16
pyramid:
  grid: geodetic
zoom_levels: 13
bounds: [16, 46, 16.1, 46.1]