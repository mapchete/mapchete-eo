process: read_xarray.py
input:
  inp:
    format: Sentinel-2
    source:
      collection: sentinel2/full_products/sentinel-2-l2a/collection.json
    time:
      start: 2023-08-10
      end: 2023-08-13
output:
  format: GTiff
  bands: 3
  path: stac
  dtype: uint16
pyramid:
  grid: geodetic
zoom_levels: 13
