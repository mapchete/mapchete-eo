process: read_xarray.py
input:
  inp:
    format: Sentinel-2
    source:
      collection: sentinel2/full_products_antimeridian/sentinel-s2-l2a/collection.json
    time:
      start: 2023-06-01
      end: 2023-06-10
output:
  format: GTiff
  bands: 3
  path: sentinel2_antimeridian_west
  dtype: uint16
pyramid:
  grid: geodetic
zoom_levels: 13
bounds: [-180, 66.6, -179, 68.5]
