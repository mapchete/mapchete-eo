# This should remain backwards compatible until the "max_cloud_cover" gets removed
# Even tho it might have been faulty even before the refractor to "source"

# what if I dont choose, have a source and want to use just "Sentinel-2" default search config

process: read_xarray.py
input:
  inp:
    format: Sentinel-2
    level: L2A
    time:
      start: 2022-06-01
      end: 2022-06-10
    max_cloud_cover: 60
output:
  format: GTiff
  bands: 3
  path: sentinel2
  dtype: uint16
pyramid:
  grid: geodetic
zoom_levels: 13
# tmx bounds 13 1879 8938
bounds: [16.3916015625, 48.69140625, 16.41357421875, 48.71337890625]